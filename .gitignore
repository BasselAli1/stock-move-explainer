# Secrets — never commit the real .env, only .env.example
.env

# Python virtual environment (created via `uv venv`)
.venv/

# Python bytecode / caches
__pycache__/
*.pyc
.pytest_cache/

# Local cache (e.g. SEC ticker-to-CIK mapping)
.cache/

# Packaging artifacts
*.egg-info/
build/
dist/

# Editor/OS cruft
.DS_Store
