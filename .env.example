# Copy this file to .env and fill in real values. Never commit .env itself.

# --- Database ---
# Neon Postgres connection string, with the pgvector extension enabled on
# that project. Example: postgresql://user:password@ep-xxxx.neon.tech/dbname?sslmode=require
DATABASE_URL=

# --- External API keys ---
ALPHA_VANTAGE_API_KEY=
OPENAI_API_KEY=
RESEND_API_KEY=

# --- Email ---
# Where the trigger explanation emails are sent, and the "from" address
# Resend should send them as (must be a verified sender/domain in Resend).
ALERT_EMAIL_TO=
ALERT_EMAIL_FROM=

# --- SEC EDGAR ---
# SEC requires a descriptive User-Agent identifying you on every request,
# e.g. "Stock Move Explainer you@example.com". Requests without one are
# rate-limited or blocked.
SEC_USER_AGENT=

# --- Tuning (optional, defaults shown) ---
# Minimum absolute daily price move, in percent, that counts as a trigger.
PRICE_MOVE_THRESHOLD_PCT=5
# OpenAI model used for the plain-language explanation step.
OPENAI_CHAT_MODEL=gpt-5.6-luna
# OpenAI model used to embed filing chunks and search queries.
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
